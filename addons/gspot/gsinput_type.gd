class_name GSInputType
## Defines the available input command types in buttplug.io.
##
## The input types define what type of sensors a device has, such as battery level, bluetooth RSSI,
## or pressure readings.

const BATTERY: String = "Battery"
const RSSI: String = "RSSI"
const PRESSURE: String = "Pressure"
const BUTTON: String = "Button"
